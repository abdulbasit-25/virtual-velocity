# Canonical public origin used by metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.thevirtualvelocity.com

# Optional public endpoint that accepts the contact form JSON payload.
# Keep blank until the production endpoint is configured.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Supabase review storage. Never expose the service-role key as NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
